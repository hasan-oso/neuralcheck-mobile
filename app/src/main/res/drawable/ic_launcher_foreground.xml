<?xml version="1.0" encoding="utf-8"?>
<!--
  NeuralCheck launcher foreground.

  Adaptive icon viewport is 108 × 108 dp but only the inner 72 × 72 dp is
  guaranteed visible (outer is cropped/masked by the launcher). We render the
  phone frame + neural graph inside a 66 dp safe zone centred at 54,54.

  Shape: a phone-shaped stroke with eight dendrites radiating from a central
  glowing core — matches the brand identity HTML mock and the web logo.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Phone outline -->
    <path
        android:pathData="M40,22 h28 a8,8 0 0 1 8,8 v48 a8,8 0 0 1 -8,8 h-28 a8,8 0 0 1 -8,-8 v-48 a8,8 0 0 1 8,-8 z"
        android:strokeColor="#38BDF8"
        android:strokeWidth="1.6"
        android:fillColor="#00000000" />

    <!-- Notch -->
    <path
        android:pathData="M48,24 h12 v1.6 a0.8,0.8 0 0 1 -0.8,0.8 h-10.4 a0.8,0.8 0 0 1 -0.8,-0.8 z"
        android:fillColor="#38BDF8"
        android:fillAlpha="0.55" />

    <!-- Dendrites (8 lines radiating from center at 54,54) -->
    <path android:pathData="M54,54 L54,30" android:strokeColor="#4ADE80" android:strokeWidth="1.6" android:strokeLineCap="round" />
    <path android:pathData="M54,54 L72,36" android:strokeColor="#4ADE80" android:strokeWidth="1.6" android:strokeLineCap="round" />
    <path android:pathData="M54,54 L76,54" android:strokeColor="#4ADE80" android:strokeWidth="1.6" android:strokeLineCap="round" />
    <path android:pathData="M54,54 L72,72" android:strokeColor="#4ADE80" android:strokeWidth="1.6" android:strokeLineCap="round" />
    <path android:pathData="M54,54 L54,78" android:strokeColor="#4ADE80" android:strokeWidth="1.6" android:strokeLineCap="round" />
    <path android:pathData="M54,54 L36,72" android:strokeColor="#4ADE80" android:strokeWidth="1.6" android:strokeLineCap="round" />
    <path android:pathData="M54,54 L32,54" android:strokeColor="#4ADE80" android:strokeWidth="1.6" android:strokeLineCap="round" />
    <path android:pathData="M54,54 L36,36" android:strokeColor="#4ADE80" android:strokeWidth="1.6" android:strokeLineCap="round" />

    <!-- Synapse endpoints -->
    <path android:pathData="M54,30 m-2.4,0 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0" android:fillColor="#4ADE80" />
    <path android:pathData="M72,36 m-2.4,0 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0" android:fillColor="#4ADE80" />
    <path android:pathData="M76,54 m-2.4,0 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0" android:fillColor="#4ADE80" />
    <path android:pathData="M72,72 m-2.4,0 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0" android:fillColor="#4ADE80" />
    <path android:pathData="M54,78 m-2.4,0 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0" android:fillColor="#4ADE80" />
    <path android:pathData="M36,72 m-2.4,0 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0" android:fillColor="#4ADE80" />
    <path android:pathData="M32,54 m-2.4,0 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0" android:fillColor="#4ADE80" />
    <path android:pathData="M36,36 m-2.4,0 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0" android:fillColor="#4ADE80" />

    <!-- Core neuron (glow) -->
    <path
        android:pathData="M54,54 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0"
        android:fillColor="#A3E635"
        android:fillAlpha="0.25" />
    <path
        android:pathData="M54,54 m-4.2,0 a4.2,4.2 0 1,0 8.4,0 a4.2,4.2 0 1,0 -8.4,0"
        android:fillColor="#A3E635" />
    <path
        android:pathData="M54,54 m-1.8,0 a1.8,1.8 0 1,0 3.6,0 a1.8,1.8 0 1,0 -3.6,0"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.85" />
</vector>
